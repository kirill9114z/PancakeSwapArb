DEFAULT_GLOBAL_SPREAD_PCT = -0.1

# Кулдаун повторных алертов по одной возможности, секунды.
ALERT_COOLDOWN_SECONDS = 300

# Минимальное изменение прибыли ($), чтобы снова слать алерт по той же возможности.
MIN_PROFIT_CHANGE_USD = 1.0

# Кулдаун (сек) на повторную попытку сделки ПО ТОЙ ЖЕ СТОРОНЕ (BUY_MEXC/SELL_MEXC)
# сразу после того, как предыдущая попытка вообще не наполнилась на MEXC (filled=0,
# ордер отменён по таймауту). Намеренно ОТДЕЛЬНАЯ константа от ALERT_COOLDOWN_SECONDS
# (300с там - это анти-спам алертов, а не пауза перед следующей реальной сделкой,
# столько ждать между попытками для арбитража неприемлемо). Без этой паузы
# analyze_opportunities на следующей же итерации видит тот же (ещё не отражённый
# в стакане/балансе) уровень и почти сразу открывает второй похожий ордер -
# см. make_trade()/_reserve_balances_for_trade().
TRADE_EMPTY_FILL_COOLDOWN_SECONDS = 2.0

# Сколько уровней стакана MEXC читать (asks/bids) за один запрос depth API.
MEXC_ORDERBOOK_DEPTH_LEVELS = 7

# Доля баланса, которую считаем «доступной» (1% запас на комиссии/округления/гонку).
BALANCE_SAFETY_FACTOR = 0.99

# Decimals у USDT/USD1 на BSC в нашем сетапе (у USD1 обычно 18, не 6 как у ERC20 USDT).
USDT_DECIMALS = 18

# Decimals нативного BNB / wei.
NATIVE_DECIMALS = 18

# Комиссия MEXC spot taker (доля): 0.05% = 0.0005. Используется в оценке прибыли.
MEXC_TAKER_FEE_RATE = 0.0005

# Консервативная комиссия Pancake, если last_fee_rate пула ещё неизвестен (0.25%).
# Реальная ставка после свопа кэшируется в OkxTrade.last_fee_rate.
DEFAULT_PANCAKE_FEE_RATE = 0.0025

# Небольшой запас в USD поверх посчитанных комиссий и газа.
# ВНИМАНИЕ: раньше эта константа была ЕДИНСТВЕННОЙ поправкой на газ в оценке
# прибыли (_calc_buy_mecx_fee), то есть стоимость хеджа считалась равной одному
# центу независимо от реальной цены газа в сети. Теперь газ считается честно
# (см. SWAP_GAS_USED_ESTIMATE_* ниже), а это - только буфер на округления.
FEE_FLAT_USD = 0.01

# Ожидаемый расход газа на один своп, пока не известен фактический (OkxTrade.last_gas_used
# запоминается из receipt после первого же успешного свопа по паре).
# Это НЕ то же самое, что SWAP_GAS_LIMIT_* ниже: лимит намеренно завышен с запасом, а на
# BSC неизрасходованный газ возвращается, поэтому СТОИМОСТЬ свопа считается по фактически
# использованному газу. Оценивать стоимость по лимиту значило бы завысить её примерно вдвое
# и без нужды отсекать прибыльные сделки.
SWAP_GAS_USED_ESTIMATE_V3 = 180000
SWAP_GAS_USED_ESTIMATE_V2 = 150000

# Как часто (сек) переспрашивать цену BNB в USD для перевода стоимости газа в доллары.
# Цена нужна только для оценки прибыли, поэтому пятиминутного кеша с запасом хватает,
# а лишний сетевой вызов в горячем цикле анализа недопустим.
BNB_PRICE_REFRESH_SECONDS = 300

# Запасная цена BNB в USD, если тикер прочитать не удалось. Намеренно ЗАВЫШЕНА:
# при ошибке лучше переоценить стоимость газа и пропустить сделку, чем недооценить
# её и взять убыточную.
BNB_PRICE_FALLBACK_USD = 1200.0

# Таймаут ожидания фила лимитного ордера на MEXC, секунды.
# Если за это время ордер не закрыт — отменяем и либо хеджим частичный fill, либо выходим.
MEXC_ORDER_FILL_TIMEOUT_SECONDS = 3

# Пауза между опросами статуса ордера на MEXC, секунды.
MEXC_ORDER_POLL_INTERVAL_SECONDS = 0.05

# ============================================================================
# Аварийное закрытие позиции на MEXC, когда DEX-своп (хедж) не прошёл
# ============================================================================
# Задача этих ордеров - НЕ "поторговать подороже", а МГНОВЕННО вернуть инвентарь
# токена к состоянию до сделки, потому что вторая нога не исполнилась. Позиция,
# оставшаяся открытой, ломает всю дальнейшую работу бота: balance_* расходятся с
# реальностью, analyze_opportunities считает возможности на несуществующем
# инвентаре, а рыночный риск по токену никем не хеджируется. Поэтому ордер
# выставляется ЗАВЕДОМО ХУЖЕ рынка, чтобы сразу смести стакан, а не встать в
# очередь. Потеря на проскальзывании здесь - осознанная плата за возврат в
# исходное состояние.
#
# Раньше тут было MEXC_EMERGENCY_BUY_PRICE = 10000 - лимитная покупка по цене
# 10000 "чтобы взять ask как маркет-бай". Это не работает: на лимитном BUY биржа
# резервирует цену * количество, то есть 100 токенов по цене 10000 - это резерв
# в $1 000 000 против ~$12 реально полученной выручки. Ордер отклонялся по
# недостатку средств, и позиция не закрывалась вообще никогда.

# На сколько процентов ЗА последний сметаемый уровень стакана ставить цену.
# Цена считается так: проходим стакан вглубь, пока накопленного объёма не хватит
# на нужное количество, берём цену последнего задетого уровня и добавляем этот
# буфер в невыгодную нам сторону (выше для покупки, ниже для продажи). Это
# гарантирует, что ордер пересечёт спред и заберёт все уровни до нужного, а не
# ляжет в стакан пассивной лимиткой.
MEXC_EMERGENCY_PRICE_BUFFER_PCT = 2.0

# Буфер на случай, когда всей видимой глубины стакана не хватает на нужный объём.
# Тогда цена ставится ещё агрессивнее - есть шанс, что за пределами видимых
# MEXC_ORDERBOOK_DEPTH_LEVELS уровней ликвидность найдётся.
MEXC_EMERGENCY_THIN_BOOK_BUFFER_PCT = 10.0

# Сколько раз повторить попытку закрытия, если ордер исполнился частично
# (стакан мог не набрать объём, цена могла уйти). Каждая попытка заново читает
# стакан и пересчитывает цену под ОСТАТОК.
MEXC_EMERGENCY_MAX_ATTEMPTS = 3

# Сколько секунд ждать исполнения аварийного ордера, прежде чем отменить остаток
# и пойти на следующую попытку. Ордер маркетабельный, поэтому должен исполниться
# практически сразу; если не исполнился - что-то не так с ценой, и лучше
# пересчитать её по свежему стакану, чем ждать.
MEXC_EMERGENCY_FILL_TIMEOUT_SECONDS = 5.0

# Доля от исходного объёма, ниже которой остаток считается пылью и не дожимается
# (0.01 = 1%). Нужна, чтобы не биться в минимальный размер ордера биржи.
MEXC_EMERGENCY_DUST_RATIO = 0.01

# Какую долю свободного баланса USDT разрешено потратить на аварийный ВЫКУП.
# Запас нужен под комиссию: если отправить ровно весь баланс, ордер отклонится.
# ВАЖНО: аварийный выкуп по определению дороже, чем была продажа (мы специально
# ставим цену хуже), поэтому выручки от продажи на полный выкуп НЕ хватает -
# нужен свободный запас USDT на аккаунте. Если его нет, бот выкупит столько,
# на сколько хватит, и явно сообщит о незакрытом остатке.
MEXC_EMERGENCY_BALANCE_SAFETY = 0.99

# Пауза между попытками аварийного закрытия, секунды. Ставится только если
# предыдущая попытка закрыла не весь объём - даёт стакану обновиться, прежде чем
# читать его заново и пересчитывать цену под остаток.
MEXC_EMERGENCY_ORDER_CHECK_DELAY_SECONDS = 1

# ============================================================================
# Журнал исполнений (arb/core/journal.py -> таблица trades в arbitrage_bot.db)
# ============================================================================
# Одна строка на КАЖДУЮ попытку сделки, включая те, что не наполнились и те, что
# закончились аварийным закрытием. Без этого журнала на вопрос "бот зарабатывает
# или нет" ответить нечем: балансы перечитываются с бирж после каждой сделки и
# затирают историю, а в логах остаются только print'ы, которые никто не агрегирует.
# Именно по этой таблице считаются доля успешных хеджей, реальное проскальзывание
# относительно прогноза quote_local и латентность каждого шага сделки.
TRADE_JOURNAL_ENABLED = True

# Пауза перед перезапуском analyze_opportunities после падения, секунды.
ANALYZE_RESTART_DELAY_SECONDS = 30

# Ретраи RPC/балансов.
BALANCE_FETCH_MAX_RETRIES = 3
BALANCE_FETCH_RETRY_DELAY_SECONDS = 5

# HTTP timeout для запроса стакана MEXC (секунды).
MEXC_DEPTH_HTTP_TIMEOUT_SECONDS = 5

# --- main.py ---
# Стартовая цена (rak) до первого чтения slot0/reserves. Дальше перезаписывается из пула.
# Если у пары сильно другая цена — не критично: get_rak обновит при старте мониторинга.
INITIAL_RAK_PRICE = 1.623

# Таймаут HTTP-клиента CCXT для MEXC, мс.
MEXC_CCXT_TIMEOUT_MS = 30000

# Пауза после старта пары до первого update_balances / анализа, секунды.
# Даёт время вебсокету пула получить первую цену.
PAIR_STARTUP_DELAY_SECONDS = 20

# --- bot.py (Telegram UI) ---
# Допустимый диапазон спреда (%) при вводе глобального/индивидуального значения.
SPREAD_INPUT_MIN_PCT = 0
SPREAD_INPUT_MAX_PCT = 100

# --- Защита цены DEX (pancake_trade) ---
# Макс. допустимое отклонение новой цены от self.rak (0.5 = ±50%).
# Если больше — событие Swap игнорируется (как в исходной логике).
PRICE_OUTLIER_THRESHOLD = 0.5

# Если buy/sell не обновлялись дольше N секунд — гасим котировки (торговля встаёт).
STALE_PRICE_SECONDS = 120

# Буфер поверх ЛОКАЛЬНО СПРОЕЦИРОВАННОЙ под объём цены (quote_local в pancake_trade.py):
# запас на задержку между анализом и реальной отправкой, MEV/фронтран, погрешность
# V3-аппроксимации в пределах текущего тика. Раньше это был единственный источник
# оценки price impact (плоский маркап поверх mid-цены независимо от объёма сделки) -
# теперь за price impact под конкретный объём отвечает quote_local(), а это - только
# небольшой защитный запас поверх её результата.
DEX_BUY_MARKUP = 1.001   # +0.1%
DEX_SELL_MARKDOWN = 0.999  # -0.1%

# --- Локальная (без RPC) проекция DEX-цены под объём сделки (pancake_trade.quote_local) ---
# Включает расчёт эффективной цены под конкретный объём кандидата в analyze_opportunities
# вместо сравнения всех уровней стакана MEXC с одной и той же плоской DEX-ценой.
# Для V2-пулов используются реальные резервы (getReserves + инкрементальное обновление
# по Swap-событиям). Для V3-пулов - "виртуальные" резервы текущего тика, вычисленные
# из liquidity (L) и sqrtPriceX96: x = L/sqrtP, y = L*sqrtP. Внутри активного тика
# V3-пул математически ведёт себя как V2-пара с такими резервами (Uniswap V3 whitepaper),
# поэтому используется одна и та же constant-product формула для обоих типов пулов.
DEX_LOCAL_PROJECTION_ENABLED = True

# Порог price impact (%), рассчитанного quote_local(), начиная с которого локальная
# V3-оценка (справедлива только в пределах текущего тика) считается недостаточно
# надёжной - требуется on-chain подтверждение (confirm_price_onchain) ПЕРЕД тем как
# брать сделку в работу. Для V2 подтверждение не требуется: реальные резервы дают
# точную формулу без аппроксимации диапазона тика.
#
# ВАЖНО про историю: здесь стояло 0.01 (0.01%), и порог срабатывал ВСЕГДА. Причина -
# impact_pct считался как отклонение эффективной цены от mid_price, а в эффективную цену
# входит комиссия пула, то есть даже при объёме, стремящемся к нулю, impact_pct был равен
# ставке пула (0.05% / 0.25% / 0.3%) и заведомо превышал порог. Последствия были не
# косметические: на каждой итерации анализа дёргался confirm_price_onchain (до 2с ожидания
# RPC), а swap_fast._estimate_amount_out_raw для V3 НИКОГДА не использовал локальную оценку
# и ходил в сеть перед каждым свопом - то есть весь смысл quote_local ("0 round-trip")
# был аннулирован. Теперь impact_pct меряется относительно цены с уже учтённой комиссией
# (см. quoting.py), то есть отражает ЧИСТОЕ проскальзывание, и порог означает ровно то,
# что написано: "локальной модели верим, пока сделка сдвигает цену меньше чем на X%".
DEX_V3_IMPACT_CONFIRM_THRESHOLD_PCT = 0.5

# Жёсткий таймаут (сек) на on-chain подтверждение цены ЛУЧШЕГО кандидата перед
# отправкой ордера на MEXC. Вызывается один раз на итерацию (только для победителя,
# не для всех уровней стакана) и только когда локальная модель отметила
# needs_confirmation - чтобы не терять время на MEXC-исполнении, ожидая RPC.
# При таймауте/ошибке сделка на этой итерации пропускается, а не берётся вслепую.
DEX_ONCHAIN_CONFIRM_TIMEOUT_SECONDS = 0.25

# Как часто (сек) переспрашивать liquidity() V3-пула поверх WS-обновлений - Swap-событие
# даёт свежие sqrtPriceX96/liquidity/tick после каждого свопа, но не ловит изменение
# ликвидности от Mint/Burn (добавление/вывод LP), на которые бот не подписан.
DEX_V3_LIQUIDITY_RESYNC_SECONDS = 60

# ============================================================================
# Быстрый путь свопа: OkxTrade.swap_fast_async (pancake_trade.py)
# ============================================================================
# swap_universal_async остаётся как есть и используется как фоллбэк: он сам ищет
# маршрут (4 fee-тира V3 + 2 пути V2) и потому работает для ЛЮБОЙ пары токенов,
# но платит за это ~8-12 последовательными RPC round-trip до отправки транзакции.
# swap_fast_async применим только когда своп идёт РОВНО через тот пул, за которым
# бот и так следит по WS (pool_kind / v3_fee_ppm / token0 / token1 уже известны) -
# то есть в 100% случаев реального хеджа, - и потому обходится 1-2 round-trip:
# всё остальное (decimals, allowance, chainId, gasPrice, nonce, маршрут, оценка
# выхода) либо прогрето при старте, либо посчитано локально через quote_local().
# Если условия не выполнены - swap_fast_async молча делегирует в swap_universal_async.

# Главный выключатель. False -> swap_fast_async всегда делегирует в
# swap_universal_async, то есть поведение бота полностью возвращается к старому.
SWAP_FAST_PATH_ENABLED = True

# Допустимое проскальзывание быстрого свопа (доля): amountOutMin = оценка * (1 - X).
# ВАЖНО: в отличие от swap_universal_async, здесь НЕТ эскалации слиппеджа по
# ретраям. Реверт из-за ушедшей цены означает, что арбитражной возможности больше
# нет, а не что надо переотправить своп с бОльшим допуском: нога на MEXC к этому
# моменту уже исполнена, и повтор на 30% слиппеджа в публичном мемпуле - это
# подарок сэндвич-боту. Вместо повтора возвращаем ошибку, а trade.handle_swap
# закрывает позицию обратно на MEXC.
SWAP_FAST_SLIPPAGE = 0.005

# Срок жизни транзакции (сек), передаётся в multicall(uint256 deadline, bytes[]).
# Прямой вызов exactInputSingle/swapExactTokensForTokens у SmartRouter deadline НЕ
# принимает - он задаётся только через обёртку multicall. Без него застрявшая в
# мемпуле транзакция может исполниться спустя минуты по давно ушедшей цене.
# Держать заметно больше времени жизни арбитражной возможности смысла нет.
SWAP_DEADLINE_SECONDS = 20

# Строгий режим "следующий блок или ничего": вместо multicall(deadline, ...)
# используется multicall(bytes32 previousBlockhash, ...) - контракт реверти́т, если
# blockhash(block.number-1) не совпал с хешем блока, который бот видел при отправке.
# Транзакция исполняется РОВНО в следующем блоке по той цене, на которую бот считал
# спред, либо не исполняется вовсе. Цена включения: +1 RPC-запрос (eth_getBlockByNumber)
# в горячем пути и оплаченный газ за реверт, если не успели в блок. По умолчанию
# выключено - включать осмысленно только на быстром приватном RPC.
SWAP_STRICT_NEXT_BLOCK = False

# Премия к eth_gasPrice для быстрого свопа. Голый gas_price - это базовая цена сети
# без приоритета: транзакция может ждать несколько блоков, а для арбитража нужен
# следующий блок. 1.25 = +25%.
SWAP_GAS_PRICE_PREMIUM = 1.25

# Жёсткий потолок цены газа (gwei) после применения премии - страховка от того, что
# всплеск gas_price в сети превратит хедж в убыточный. 0 = без потолка.
SWAP_GAS_PRICE_MAX_GWEI = 10.0

# Как часто (сек) фоново обновлять кеш цены газа в цикле monitoring_price.
# Горячий путь свопа берёт готовое значение из кеша и в сеть за ним НЕ ходит.
SWAP_GAS_PRICE_REFRESH_SECONDS = 5.0

# Возраст (сек), после которого кеш цены газа считается протухшим и swap_fast_async
# всё-таки сходит за ней в сеть перед отправкой (корректность важнее одного round-trip).
SWAP_GAS_PRICE_MAX_AGE_SECONDS = 30.0

# Фиксированные лимиты газа вместо eth_estimateGas (это -1 round-trip в горячем пути).
# Маршрут известен заранее и всегда один и тот же, так что оценивать нечего.
# Неизрасходованный газ на BSC возвращается - завышенный лимит не стоит ничего,
# кроме требования держать соответствующий баланс BNB.
SWAP_GAS_LIMIT_V3 = 400000
SWAP_GAS_LIMIT_V2 = 400000

# Жёсткий таймаут (сек) ожидания receipt. У web3 дефолт 120с, и всё это время
# держится _swap_lock, а analyze_opportunities по паре стоит (make_trade ожидается
# через await). При таймауте своп НЕ переотправляется - возвращается
# FATAL_UNKNOWN_STATUS, чтобы не создать вторую реальную транзакцию.
SWAP_RECEIPT_TIMEOUT_SECONDS = 20.0

# Приватный (MEV-защищённый) RPC для отправки подписанной транзакции. Пустая строка -
# отправка в обычный публичный мемпул, где прибыльный своп с видимым amountOutMin
# доступен сэндвич-ботам. Сюда уходит ТОЛЬКО eth_sendRawTransaction; котировки и
# receipt по-прежнему читаются с основного RPC. Если приватная отправка не удалась,
# бот повторяет её на основном RPC - дубликата свопа это создать не может, так как
# повторно отправляется та же подписанная транзакция с тем же хешем и nonce.
# Примеры для BSC: "https://rpc.48.club" (48 Club Puissant), эндпоинт bloXroute.
SWAP_PRIVATE_TX_RPC = ""

# Сколько раз повторить ОТПРАВКУ при сетевой/nonce-ошибке (без sleep между попытками).
# Касается только неудачной отправки; реверт уже отправленной транзакции не
# ретраится вообще - см. комментарий к SWAP_FAST_SLIPPAGE.
SWAP_FAST_MAX_SEND_RETRIES = 2
